# FalkorDB connection
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_USERNAME=
FALKORDB_PASSWORD=
FALKORDB_MAX_CONNECTIONS=64
# Browser UI port for docker compose (3000 is the image default)
FALKORDB_BROWSER_PORT=3000

# Providers: anthropic | openai | ollama | fastembed | fake
#   LLM:        fake | anthropic | openai | ollama
#   Embeddings: fake | fastembed | openai | ollama   (Anthropic has no embedding API)
DOMESDAY_LLM_PROVIDER=fake
DOMESDAY_EMBED_PROVIDER=fake
# Optional model overrides (each provider has a sensible default)
DOMESDAY_LLM_MODEL=
DOMESDAY_EMBED_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Behaviour
DOMESDAY_QUERY_TIMEOUT_MS=30000
DOMESDAY_ASYNC_WRITES=false

# MCP server (SSE)
DOMESDAY_MCP_HOST=127.0.0.1
DOMESDAY_MCP_PORT=8765
